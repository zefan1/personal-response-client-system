[Unit]
Description=WeCom Smart Sheet Callback Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pda-relay
Group=pda-relay
EnvironmentFile=/etc/private-domain-assistant/wecom-callback-relay.env
ExecStart=/usr/bin/python3 /opt/wecom-callback-relay/relay.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wecom-callback-relay

[Install]
WantedBy=multi-user.target
