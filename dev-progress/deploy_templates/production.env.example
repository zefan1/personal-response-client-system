# Private Domain Assistant production environment template
# Copy to the server as /opt/private-domain-assistant/config/production.env
# Fill real values on the server only. Do not commit real secrets.

APP_ENV=production
MOCK_EXTERNALS=false
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/private_domain_assistant_prod?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=pda_prod
SPRING_DATASOURCE_PASSWORD=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Required for the production WeCom Relay. Keep the WeCom app secret on the
# relay server, not in this application environment file.
WECOM_TRANSPORT_MODE=RELAY
WECOM_RELAY_BASE_URL=https://wecom-relay.example.com
WECOM_RELAY_KEY_ID=replace-me
WECOM_RELAY_SECRET=replace-me

# Initial primary Smart Sheet target. The administrator can later update the
# target in the management console after the Relay connection has been proven.
WECOM_SMARTSHEET_DOC_ID=replace-me
WECOM_SMARTSHEET_SHEET_ID=replace-me
WECOM_SMARTSHEET_VIEW_ID=replace-me
WECOM_SMARTSHEET_SOURCE_TABLE=replace-me
WECOM_SMARTSHEET_UNIQUE_FIELD_TITLE=replace-me

# Required for WeCom Smart Sheet row-change callbacks. Generate both values in
# the WeCom application callback configuration and keep the real values only
# in the server environment.
WECOM_CALLBACK_TOKEN=replace-me
WECOM_CALLBACK_ENCODING_AES_KEY=replace-me

# Must be replaced before production. Generate at least 32 random bytes.
SYSTEM_JWT_SECRET=change-me-in-production

VERSION_STORAGE_ROOT=/data/private-domain-assistant/uploads/desktop-releases
VERSION_PUBLIC_BASE_URL=/downloads/desktop-releases

# Optional JVM tuning for the systemd service.
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
