# Real-provider acceptance only. Do not use production customer data or a production Smart Sheet.
# Keep this file outside Git and load it only for the controlled P0 acceptance command.

PDA_LIVE_SKILL_BASE_URL=https://skill-provider.example.com
PDA_LIVE_SKILL_API_KEY=replace-me
PDA_LIVE_IMAGE_BASE_URL=https://image-provider.example.com
PDA_LIVE_IMAGE_API_KEY=replace-me
PDA_LIVE_LLM_BASE_URL=https://llm-provider.example.com
PDA_LIVE_LLM_API_KEY=replace-me
PDA_LIVE_LLM_MODEL=replace-me

# Use a dedicated, non-production Smart Sheet. The acceptance run creates one
# test record, updates it, and reads it back before checking formula protection.
WECOM_TRANSPORT_MODE=RELAY
WECOM_RELAY_BASE_URL=https://wecom-relay.example.com
WECOM_RELAY_KEY_ID=replace-me
WECOM_RELAY_SECRET=replace-me
WECOM_SMARTSHEET_DOC_ID=replace-me
WECOM_SMARTSHEET_SHEET_ID=replace-me
WECOM_SMARTSHEET_VIEW_ID=replace-me
WECOM_SMARTSHEET_SOURCE_TABLE=replace-me
WECOM_SMARTSHEET_UNIQUE_FIELD_TITLE=replace-me

# Required for the Smart Sheet row-change callback acceptance. Values are
# generated in WeCom and must not be committed with an acceptance file.
WECOM_CALLBACK_TOKEN=replace-me
WECOM_CALLBACK_ENCODING_AES_KEY=replace-me

# Point to a de-identified, controlled chat screenshot. The request file is
# deleted immediately after submission; the image is not retained in reports.
PDA_LIVE_ACCEPTANCE_SCREENSHOT_PATH=C:/secure-path/controlled-chat.png
PDA_LIVE_ACCEPTANCE_CONFIRM=ISOLATED_WECOM_SHEET
