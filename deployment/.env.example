# Copy to deployment/.env on the server. Replace every CHANGE_ME value.
PDA_DOMAIN=localhost
PDA_HTTP_PORT=80
# Optional comma-separated browser origins. The server URL is added automatically.
APP_CORS_ALLOWED_ORIGINS=
DB_NAME=private_domain_assistant_prod
DB_USER=pda_prod
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
SYSTEM_JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_SECRET
MOCK_EXTERNALS=false
VITE_DEFAULT_API_BASE_URL=/
MAX_FILE_SIZE=600MB

# Optional real integrations. Leave blank until configured in the admin console.
WECOM_TRANSPORT_MODE=RELAY
WECOM_RELAY_BASE_URL=http://host.docker.internal:18081
WECOM_RELAY_KEY_ID=
WECOM_RELAY_SECRET=
WECOM_CORP_ID=
WECOM_APP_SECRET=
WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
WECOM_SMARTSHEET_DOC_ID=
WECOM_SMARTSHEET_SHEET_ID=
WECOM_SMARTSHEET_VIEW_ID=
WECOM_SMARTSHEET_SOURCE_TABLE=
WECOM_SMARTSHEET_UNIQUE_FIELD_TITLE=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_ENCODING_AES_KEY=
